# Immich server reached over Tailscale (brick 1 sets it up in bb-homelab)
IMMICH_BASE_URL=https://immich.bb-homelab.local/api
# Scoped API key: asset read/download/update/delete, album read/update. Named and dated at creation.
IMMICH_API_KEY=replace-me
# Album the phone backs up to
IMMICH_ALBUM=Screenshots
# Album where captures answered "personal" are moved; never read by the tool
IMMICH_PERSONAL_ALBUM=Personnel
# Local working folder (git-ignored)
DATA_DIR=./data
